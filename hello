<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>GraphMaster</title><style>*{box-sizing:border-box;font-family:system-ui;margin:0;padding:0}body{background:#f0f4ff;display:flex;justify-content:center}.app{width:100%;max-width:420px;background:#fff;min-height:100vh}.top{background:#1e40af;color:#fff;padding:14px;text-align:center}canvas{width:100%;height:410px;border:3px solid #000;border-radius:16px;display:block;touch-action:none;margin:12px;width:calc(100% - 24px)}.hud{margin:0 12px;background:#0f172a;color:#fff;border-radius:12px;padding:10px;font-weight:700;font-size:12px}.row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px}.card{border:2px solid #ddd;border-radius:12px;padding:8px;text-align:center;font-weight:800;font-size:11px}.btnRow{display:flex;gap:8px;margin:12px}.btn{flex:1;padding:14px;border:none;border-radius:12px;font-weight:900;color:#fff}.b-blue{background:#2563eb}.b-red{background:#ef4444}.b-green{background:#16a34a}.b-dark{background:#0f172a}</style></head><body><div class="app"><div class="top"><h1>GraphMaster EASY</h1></div><canvas id="c" width="420" height="410"></canvas><div class="hud" id="hud">👆 Drag dots - LIVE tracking</div><div class="row"><div class="card" id="b">🔵 x+y=5<br><span id="b1"></span></div><div class="card" id="o">🟠 x-y=1<br><span id="o1"></span></div></div><div class="btnRow"><button class="btn b-blue" onclick="autoPlot()">🤖 AUTO PLOT</button><button class="btn b-green" onclick="check()">✅ CHECK</button></div><div class="btnRow"><button class="btn b-dark" onclick="location.reload()">↻ RESET</button></div></div><script>
let eq1={c:5,f:x=>5-x},eq2={c:1,f:x=>x-1},blue=[{x:0,y:5},{x:5,y:0}],orange=[{x:1,y:0},{x:3,y:2}],drag=null;const c=document.getElementById('c'),ctx=c.getContext('2d'),W=420,H=410,pad=38,sc=48;function toPx(p){return{px:pad+p.x*sc,py:H-pad-p.y*sc}}function toMath(px,py){return{x:(px-pad)/sc,y:(H-pad-py)/sc}}function snap(v){return Math.round(v*10)/10}function draw(){ctx.clearRect(0,0,W,H);for(let i=0;i<=70;i++){let x=pad+i*sc/10;ctx.strokeStyle=i%10==0?'#94a3b8':'#f1f5f9';ctx.lineWidth=i%10==0?0.8:0.2;ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H-pad);ctx.stroke()}for(let j=0;j<=70;j++){let y=H-pad-j*sc/10;ctx.strokeStyle=j%10==0?'#94a3b8':'#f1f5f9';ctx.lineWidth=j%10==0?0.8:0.2;ctx.beginPath();ctx.moveTo(pad,y);ctx.lineTo(W,y);ctx.stroke()}ctx.fillStyle='#000';ctx.font='bold 11px system-ui';for(let i=0;i<=7;i++){let p=toPx({x:i,y:0});ctx.fillText(i,p.px-3,H-8)}ctx.strokeStyle='#000';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(pad,0);ctx.lineTo(pad,H-pad);ctx.lineTo(W,H-pad);ctx.stroke();let b0=toPx(blue[0]),b1=toPx(blue[1]);ctx.strokeStyle='#2563eb';ctx.lineWidth=5;ctx.beginPath();ctx.moveTo(b0.px,b0.py);ctx.lineTo(b1.px,b1.py);ctx.stroke();let o0=toPx(orange[0]),o1=toPx(orange[1]);ctx.strokeStyle='#f97316';ctx.lineWidth=5;ctx.beginPath();ctx.moveTo(o0.px,o0.py);ctx.lineTo(o1.px,o1.py);ctx.stroke();for(let p of blue){let q=toPx(p);ctx.fillStyle='#1d4ed8';ctx.beginPath();ctx.arc(q.px,q.py,14,0,6.28);ctx.fill();ctx.fillStyle='#fff';ctx.font='bold 10px system-ui';ctx.fillText(`(${p.x.toFixed(1)},${p.y.toFixed(1)})`,q.px+16,q.py)}for(let p of orange){let q=toPx(p);ctx.fillStyle='#ea580c';ctx.beginPath();ctx.arc(q.px,q.py,14,0,6.28);ctx.fill();ctx.fillStyle='#fff';ctx.fillText(`(${p.x.toFixed(1)},${p.y.toFixed(1)})`,q.px+16,q.py)}document.getElementById('b1').innerText=`P1(${blue[0].x.toFixed(1)},${blue[0].y.toFixed(1)}) P2(${blue[1].x.toFixed(1)},${blue[1].y.toFixed(1)})`;document.getElementById('o1').innerText=`P1(${orange[0].x.toFixed(1)},${orange[0].y.toFixed(1)}) P2(${orange[1].x.toFixed(1)},${orange[1].y.toFixed(1)})`}function autoPlot(){alert('Auto plot: x=0 y=5, x=1 y=4 etc. Drag to see LIVE')}function check(){alert('Correct! Intersection is (3,2) - This is answer')}c.addEventListener('pointerdown',e=>{let r=c.getBoundingClientRect(),px=(e.clientX-r.left)*(W/r.width),py=(e.clientY-r.top)*(H/r.height);for(let i=0;i<2;i++){let q=toPx(blue[i]);if(Math.hypot(px-q.px,py-q.py)<20){drag={arr:blue,i};return}}for(let i=0;i<2;i++){let q=toPx(orange[i]);if(Math.hypot(px-q.px,py-q.py)<20){drag={arr:orange,i};return}}});c.addEventListener('pointermove',e=>{if(!drag)return;let r=c.getBoundingClientRect(),px=(e.clientX-r.left)*(W/r.width),py=(e.clientY-r.top)*(H/r.height);let m=toMath(px,py);m.x=snap(Math.max(0,Math.min(7,m.x)));m.y=snap(Math.max(0,Math.min(7,m.y)));drag.arr[drag.i]=m;document.getElementById('hud').innerText=`LIVE: now at (${m.x.toFixed(1)},${m.y.toFixed(1)})`;draw()});c.addEventListener('pointerup',()=>drag=null);draw();
</script></body></html>